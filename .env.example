# Copy the Next.js variables into apps/web/.env.local.
# Copy the Studio variables into apps/studio/.env.
# Keep both apps on the same Sanity project and dataset.
# Leave SANITY_API_TOKEN empty in git. Set it only in the server environment.

NEXT_PUBLIC_SANITY_PROJECT_ID=xn4502ws
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
SANITY_API_TOKEN=
GOOGLE_API_KEY=

SANITY_STUDIO_PROJECT_ID=xn4502ws
SANITY_STUDIO_DATASET=production
